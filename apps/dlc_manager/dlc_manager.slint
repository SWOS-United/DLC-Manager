// dlc_manager.slint -- browse, download and install SWOS DLC.
//
// The Delphi form (contents_downloader_u.dfm) gave each of the 17 DLC types its
// own tab, with the sprite types nested in a second tab strip and the music
// types in a third -- 17 near-identical layouts to keep in step. Here the type
// is a sidebar selection and there is one list/preview layout, because every
// type behaves the same: pick an item, download it, select it, remove it.
//
// C++ owns all the state; this file renders `Dlc` and calls back.

import {
    Button, CheckBox, ComboBox, GroupBox, HorizontalBox, LineEdit, ListView,
    Palette, ProgressIndicator, ScrollView, VerticalBox
} from "std-widgets.slint";

// One pack. `flag` indexes assets/icons/flags.png, the strip lifted from the
// Delphi form, or is -1 for the categories that showed no flag.
export struct DlcRow {
    title: string,
    author: string,
    installed: string,
    latest: string,
    status: string,
    // 0 new, 1 installed, 2 update, 3 removed -- drives the status colour.
    status-kind: int,
    flag: int,
}

export struct DlcCategory {
    label: string,
    // Section heading above the first entry of a group, "" for the rest.
    group: string,
    badge: int,        // new + updated packs, 0 hides the badge
    icon: image,
    // The sprite categories use the game's own full-colour artwork, which must
    // be drawn as-is; the rest are monochrome glyphs that need tinting to the
    // palette so they work in both themes.
    tint-icon: bool,
}

export global Dlc {
    // --- Categories (the 17 types) ---
    in property <[DlcCategory]> categories;
    in-out property <int> current-category: 0;

    // --- The selected category's list ---
    in property <[DlcRow]> rows;
    in-out property <int> current-row: -1;

    // --- Detail of the highlighted row ---
    in property <string> detail-title;
    in property <string> detail-author;
    in property <string> detail-version;
    in property <string> detail-description;
    in property <string> detail-status;
    in property <bool> detail-installed;
    in property <bool> row-selected;

    // Preview: exactly one of these is meaningful, per the category.
    in property <bool> preview-is-audio;
    in property <image> preview-image;
    in property <bool> preview-image-available;
    in property <bool> audio-available;
    in property <bool> audio-playing;

    // --- Which pack is applied to the game ---
    in property <string> applied-title;
    in property <bool> has-enabled-flag;
    in-out property <bool> enabled;
    // The list is SWOS United's mods (an index.json) rather than SWOS 2020's
    // packs: "applied" is then "turned on", per mod, in SWOS.ini [mods].
    in property <bool> mods-mode;
    in property <bool> detail-on;

    // --- Busy state ---
    in property <bool> busy;
    in property <string> busy-label;
    in property <float> busy-fraction;   // 0..1; negative means indeterminate
    in property <string> status-message;
    in property <bool> status-is-error;
    in property <bool> offline;

    callback category-changed(int);
    callback row-changed(int);
    callback enabled-changed(bool);
}

// One property per DLC type id, so C++ can hand the right image back in
// DlcCategory. @image-url only accepts a literal path, which is why these
// cannot be built on the C++ side -- and why they must live in a global rather
// than being loaded from disk at runtime: the build embeds these files into the
// binary, so a copied or installed app still has its icons.
// The flag strip from the original DLC manager, kept as one sheet and clipped
// per cell rather than split into 51 files. Indices are the original's.
export global Flags {
    out property <image> sheet: @image-url("../../assets/icons/flags.png");
    out property <int> cell: 16;
    out property <int> columns: 4;
}

export global DlcIcons {
    out property <image> teamdb: @image-url("../../assets/icons/dlc/teamdb.svg");
    out property <image> pitch: @image-url("../../assets/icons/dlc/pitch.svg");
    out property <image> cup: @image-url("../../assets/icons/dlc/cup.svg");
    out property <image> bgi2: @image-url("../../assets/icons/dlc/bgi2.svg");
    out property <image> commentary: @image-url("../../assets/icons/dlc/commentary.svg");
    out property <image> fx: @image-url("../../assets/icons/dlc/fx.svg");
    out property <image> tmusic: @image-url("../../assets/icons/dlc/tmusic.svg");
    out property <image> mmusic: @image-url("../../assets/icons/dlc/mmusic.svg");
    out property <image> sprite-ball: @image-url("../../assets/icons/dlc/sprite_ball.svg");
    out property <image> sprite-gk: @image-url("../../assets/icons/dlc/sprite_gk.svg");
    out property <image> sprite-goalnet: @image-url("../../assets/icons/dlc/sprite_goalnet.svg");
    out property <image> sprite-manager: @image-url("../../assets/icons/dlc/sprite_manager.svg");
    out property <image> sprite-referee: @image-url("../../assets/icons/dlc/sprite_referee.svg");
    out property <image> sprite-team1: @image-url("../../assets/icons/dlc/sprite_team1.svg");
    out property <image> sprite-team2: @image-url("../../assets/icons/dlc/sprite_team2.svg");
    out property <image> sprite-team3: @image-url("../../assets/icons/dlc/sprite_team3.svg");
    out property <image> sprite-flag: @image-url("../../assets/icons/dlc/sprite_flag.svg");
}

export global DlcActions {
    callback refresh-catalog();
    callback download();
    callback apply-selection();
    callback remove();
    callback cancel();
    callback play-preview();
    callback stop-preview();
    callback open-folder();
}

// The About dialog (the header's info button): Baker76's, as Palette Agent's.
export global About {
    in-out property <bool> open;
    in property <string> version;
    callback open-url(string);    // a logo clicked: its website, in the browser
}

// A logo that opens its website.
component LinkLogo inherits Rectangle {
    in property <string> url;
    in property <string> label;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { About.open-url(root.url); }
    }
    opacity: touch.has-hover ? 0.85 : 1.0;
    accessible-role: button;
    accessible-label: root.label;
}

export global Theme {
    in-out property <int> mode: 0;          // 0 system, 1 light, 2 dark
    in-out property <int> system-scheme: 1; // 1 light, 2 dark
    out property <bool> is-dark: mode == 2 || (mode == 0 && system-scheme == 2);
    public function apply() {
        Palette.color-scheme = self.is-dark ? ColorScheme.dark : ColorScheme.light;
    }
}

component Icon inherits Image {
    in property <length> size: 18px;
    in property <color> tint: Palette.foreground;
    // Full-colour artwork must not be recoloured; a transparent colorize is
    // Slint's "leave the pixels alone".
    in property <bool> tinted: true;
    width: root.size;
    height: root.size;
    colorize: root.tinted ? root.tint : Colors.transparent;
    image-fit: contain;
    accessible-role: none;
}

component ThemeToggle inherits HorizontalLayout {
    spacing: 2px;
    for entry[index] in [
        { icon: @image-url("../../assets/icons/brightness-auto.svg"), tip: "Follow the system theme" },
        { icon: @image-url("../../assets/icons/sun.svg"), tip: "Light theme" },
        { icon: @image-url("../../assets/icons/moon.svg"), tip: "Dark theme" },
    ] : Rectangle {
        width: 30px;
        height: 26px;
        border-radius: 5px;
        background: Theme.mode == index ? Palette.accent-background.transparentize(0.8)
                  : entry-touch.has-hover ? Palette.foreground.transparentize(0.92)
                  : transparent;
        Icon {
            size: 16px;
            source: entry.icon;
            tint: Theme.mode == index ? Palette.accent-background
                                      : Palette.foreground.transparentize(0.3);
        }
        entry-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { Theme.mode = index; Theme.apply(); }
        }
        accessible-role: button;
        accessible-label: entry.tip;
    }
}

component CreditRow inherits HorizontalLayout {
    in property <string> role;
    in property <string> names;
    spacing: 16px;
    Text {
        text: root.role;
        width: 210px;
        color: Palette.foreground.transparentize(0.35);
    }
    Text {
        text: root.names;
        wrap: word-wrap;
        color: Palette.foreground;
        horizontal-stretch: 1;
    }
}

component AboutDialog inherits Rectangle {
    background: #00000060;
    TouchArea { }      // nothing behind it takes a click while it is open
    panel := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(560px, root.width - 32px);
        height: min(layout.preferred-height, root.height - 32px);
        background: Palette.background;
        border-radius: 6px;
        border-width: 1px;
        border-color: Palette.border;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000050;

        layout := VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Text {
                text: "About";
                font-size: 15px;
                font-weight: 600;
                color: Palette.foreground;
            }
            HorizontalLayout {
                spacing: 16px;
                Image {
                    width: 96px;
                    height: 96px;
                    source: @image-url("../../assets/icon/swos.svg");
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: "SWOS United DLC Manager " + About.version;
                        font-size: 20px;
                        font-weight: 600;
                        color: Palette.foreground;
                    }
                    Text { text: "by Ben Baker"; color: Palette.foreground; }
                    Text { text: "https://github.com/SWOS-United/DLC-Manager"; color: Palette.foreground; }
                }
            }
            // SWOS United's credits, as the launcher's About page had them.
            Rectangle {
                background: Palette.alternate-background;
                border-radius: 4px;
                border-width: 1px;
                border-color: Palette.border;
                VerticalLayout {
                    padding: 10px;
                    spacing: 6px;
                    CreditRow { role: "Project Management"; names: "Playaveli"; }
                    CreditRow { role: "Engineering Lead"; names: "benbaker76"; }
                    CreditRow { role: "SWOS Reverse Engineering"; names: "benbaker76 (Amiga) / zkz (DOS)"; }
                    CreditRow { role: "SWOS 2020 Feature Engineering"; names: "starwindz"; }
                    CreditRow { role: "SWOS Live (swos.eu)"; names: "Redhair"; }
                    CreditRow { role: "SWOS Multiplayer (GGPO-X)"; names: "thd79"; }
                    CreditRow { role: "SWOS Web Online Rankings"; names: "ElMichaJ"; }
                    CreditRow { role: "Beta Testers"; names: "crom1, ElMichaJ, EMPI, gatifun, petarku, Playaveli, Predicador, Redhair, segra, starwindz, thd79"; }
                    CreditRow { role: "Donators"; names: "benbaker76, Playaveli, starwindz, Petarku, gatifun, burellapaolo, az0man0, Cartoplotus68, JoSon, aliko"; }
                }
            }
            // Baker76's lettering is drawn for a dark ground, so it has one in both themes.
            LinkLogo {
                url: "https://baker76.com";
                label: "Baker76 (baker76.com)";
                background: #202020;
                border-radius: 8px;
                HorizontalLayout {
                    alignment: center;
                    padding: 14px;
                    Image {
                        height: 36px;
                        width: 36px * 1008.38 / 162.4;
                        source: @image-url("../../assets/about/baker76.svg");
                    }
                }
            }
            HorizontalLayout {
                alignment: center;
                LinkLogo {
                    url: "https://slint.dev";
                    label: "Made with Slint (slint.dev)";
                    height: 56px;
                    width: self.height * 212 / 97;
                    Image {
                        width: parent.width;
                        height: parent.height;
                        source: @image-url("../../assets/about/made-with-slint.svg");
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button {
                    text: "OK";
                    primary: true;
                    clicked => { About.open = false; }
                }
            }
        }
    }
}

component CategoryRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected;
    in property <int> badge;
    in property <image> icon;
    in property <bool> tint-icon: true;
    callback clicked();

    height: 30px;
    border-radius: 5px;
    background: root.selected ? Palette.accent-background.transparentize(0.82)
              : touch.has-hover ? Palette.foreground.transparentize(0.94)
              : transparent;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 8px;
        Icon {
            size: 20px;
            source: root.icon;
            tinted: root.tint-icon;
            // Tinting only applies to the glyphs; the selected row highlights
            // those in the accent colour like its label.
            tint: root.selected ? Palette.accent-background : Palette.foreground;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-weight: root.selected ? 700 : 400;
            color: root.selected ? Palette.accent-background : Palette.foreground;
            overflow: elide;
            horizontal-stretch: 1;
        }
        // Count of new + updated packs waiting in this category.
        if root.badge > 0: Rectangle {
            y: (parent.height - self.height) / 2;
            height: 17px;
            width: badge-text.preferred-width + 10px;
            border-radius: 8px;
            background: Palette.accent-background;
            badge-text := Text {
                text: root.badge;
                font-size: 10px;
                font-weight: 700;
                color: Palette.accent-foreground;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component DlcManagerWindow inherits Window {
    title: "SWOS United DLC Manager";
    preferred-width: 1260px;
    preferred-height: 780px;
    min-width: 900px;
    min-height: 600px;
    background: Palette.background;

    VerticalBox {
        padding: 14px;
        spacing: 10px;

        // ---- Header -----------------------------------------------------
        HorizontalBox {
            padding: 0px;
            spacing: 12px;
            vertical-stretch: 0;

            // SWOS United's banner, then what this is.
            VerticalLayout {
                alignment: center;
                Image {
                    height: 44px;
                    width: self.height * 685 / 81;
                    source: @image-url("../../assets/about/swos-united-banner.png");
                    accessible-role: none;
                }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: "DLC Manager";
                    font-size: 20px;
                    font-weight: 800;
                    color: Palette.foreground;
                }
                Text {
                    text: Dlc.offline ? "Offline -- showing what is already installed"
                                      : Dlc.mods-mode ? "SWOS United mods" : "sensiblesoccer.de/swos2020";
                    font-size: 11px;
                    color: Dlc.offline ? #d1495b : Palette.foreground.transparentize(0.45);
                }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                Button {
                    text: "Refresh catalogue";
                    enabled: !Dlc.busy;
                    clicked => { DlcActions.refresh-catalog(); }
                }
            }
            VerticalLayout {
                alignment: center;
                ThemeToggle { }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 30px;
                    height: 26px;
                    border-radius: 5px;
                    background: about-touch.has-hover ? Palette.foreground.transparentize(0.92) : transparent;
                    Icon {
                        size: 16px;
                        source: @image-url("../../assets/icons/info-circle.svg");
                        tint: Palette.foreground.transparentize(0.3);
                    }
                    about-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { About.open = true; }
                    }
                    accessible-role: button;
                    accessible-label: "About";
                }
            }
        }

        // ---- Body: categories | list | detail ----------------------------
        HorizontalBox {
            padding: 0px;
            spacing: 12px;
            vertical-stretch: 1;

            // Categories
            Rectangle {
                width: 210px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.alternate-background;

                ScrollView {
                    VerticalLayout {
                        padding: 6px;
                        spacing: 1px;
                        alignment: start;
                        for category[index] in Dlc.categories: VerticalLayout {
                            // Group heading, drawn once per section.
                            if category.group != "": Text {
                                text: category.group;
                                font-size: 10px;
                                font-weight: 700;
                                color: Palette.foreground.transparentize(0.5);
                                height: 24px;
                                vertical-alignment: bottom;
                                horizontal-alignment: left;
                            }
                            CategoryRow {
                                label: category.label;
                                badge: category.badge;
                                icon: category.icon;
                                tint-icon: category.tint-icon;
                                selected: Dlc.current-category == index;
                                clicked => {
                                    Dlc.current-category = index;
                                    Dlc.category-changed(index);
                                }
                            }
                        }
                    }
                }
            }

            // Available packs
            packs := VerticalBox {
                padding: 0px;
                spacing: 8px;
                horizontal-stretch: 3;

                // Column geometry, shared by the header and the rows.
                //
                // Exactly one column may be flexible. A layout sizes stretchy
                // children from their *preferred* width plus a share of the
                // slack, and the header's preferred widths ("Author") are
                // nothing like a row's ("Francescomanetti82 and Gorzo"), so two
                // stretchy columns put the header and the rows in different
                // places. With only Title flexible, every other column is a
                // fixed width in both and Title takes the identical remainder.
                //
                // The flag column is part of that geometry, so the header
                // reserves the same width even though it has nothing to draw.
                property <length> col-flag: 20px;
                property <length> col-author: 150px;
                property <length> col-installed: 72px;
                property <length> col-latest: 64px;
                property <length> col-status: 80px;

                // Header
                Rectangle {
                    height: 28px;
                    vertical-stretch: 0;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 8px;
                        // Matches the rows' flag column so the two line up.
                        Rectangle { width: packs.col-flag; }
                        Text {
                            text: "Title";
                            vertical-alignment: center;
                            font-size: 11px;
                            font-weight: 700;
                            color: Palette.foreground.transparentize(0.4);
                            horizontal-stretch: 1;
                            min-width: 60px;
                            overflow: elide;
                        }
                        Text {
                            text: "Author"; width: packs.col-author;
                            vertical-alignment: center; font-size: 11px; font-weight: 700;
                            color: Palette.foreground.transparentize(0.4);
                            overflow: elide;
                        }
                        Text {
                            text: "Installed"; width: packs.col-installed;
                            vertical-alignment: center; font-size: 11px; font-weight: 700;
                            color: Palette.foreground.transparentize(0.4);
                        }
                        Text {
                            text: "Latest"; width: packs.col-latest;
                            vertical-alignment: center; font-size: 11px; font-weight: 700;
                            color: Palette.foreground.transparentize(0.4);
                        }
                        Text {
                            text: "Status"; width: packs.col-status;
                            vertical-alignment: center; font-size: 11px; font-weight: 700;
                            color: Palette.foreground.transparentize(0.4);
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Palette.border;
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for row[index] in Dlc.rows: Rectangle {
                        height: 30px;
                        background: Dlc.current-row == index
                                  ? Palette.accent-background.transparentize(0.8)
                                  : row-touch.has-hover
                                  ? Palette.foreground.transparentize(0.95)
                                  : transparent;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;

                            // The flag, clipped out of the shared strip. Kept at
                            // its native 16px and pixelated: it is a 16x16
                            // bitmap, and smoothing it just makes it muddy.
                            Rectangle {
                                width: packs.col-flag;
                                if row.flag >= 0: Image {
                                    source: Flags.sheet;
                                    source-clip-x: mod(row.flag, Flags.columns) * Flags.cell;
                                    source-clip-y: floor(row.flag / Flags.columns) * Flags.cell;
                                    source-clip-width: Flags.cell;
                                    source-clip-height: Flags.cell;
                                    width: 16px;
                                    height: 16px;
                                    image-rendering: pixelated;
                                }
                            }

                            Text {
                                text: row.title;
                                vertical-alignment: center;
                                overflow: elide;
                                color: Palette.foreground;
                                horizontal-stretch: 1;
                                min-width: 60px;
                            }
                            Text {
                                text: row.author; width: packs.col-author;
                                vertical-alignment: center; overflow: elide; font-size: 12px;
                                color: Palette.foreground.transparentize(0.3);
                            }
                            Text {
                                text: row.installed; width: packs.col-installed;
                                vertical-alignment: center; font-size: 12px;
                                color: Palette.foreground.transparentize(0.3);
                            }
                            Text {
                                text: row.latest; width: packs.col-latest;
                                vertical-alignment: center; font-size: 12px;
                                color: Palette.foreground.transparentize(0.3);
                            }
                            Text {
                                text: row.status; width: packs.col-status;
                                vertical-alignment: center; font-size: 12px; font-weight: 600;
                                color: row.status-kind == 0 ? Palette.accent-background
                                     : row.status-kind == 2 ? #d98324
                                     : row.status-kind == 3 ? Palette.foreground.transparentize(0.55)
                                     : #3fa34d;
                            }
                        }

                        row-touch := TouchArea {
                            clicked => {
                                Dlc.current-row = index;
                                Dlc.row-changed(index);
                            }
                        }
                    }
                }

                // Applied selection + the per-type enable switch.
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    vertical-stretch: 0;
                    Text {
                        text: (Dlc.mods-mode ? "On: " : "Applied: ") + (Dlc.applied-title == "" ? "(none)" : Dlc.applied-title);
                        vertical-alignment: center;
                        color: Palette.foreground.transparentize(0.25);
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if Dlc.has-enabled-flag: CheckBox {
                        text: "Enabled in game";
                        checked <=> Dlc.enabled;
                        toggled => { Dlc.enabled-changed(self.checked); }
                    }
                }
            }

            // Detail + preview
            Rectangle {
                width: 330px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.alternate-background;

                VerticalBox {
                    padding: 12px;
                    spacing: 10px;
                    alignment: start;

                    if !Dlc.row-selected: Text {
                        text: "Select a pack to see its details.";
                        wrap: word-wrap;
                        color: Palette.foreground.transparentize(0.45);
                    }

                    if Dlc.row-selected: Text {
                        text: Dlc.detail-title;
                        font-size: 14px;
                        font-weight: 700;
                        wrap: word-wrap;
                        color: Palette.foreground;
                    }
                    if Dlc.row-selected: Text {
                        text: Dlc.detail-author + "   ·   " + Dlc.detail-version;
                        font-size: 11px;
                        wrap: word-wrap;
                        color: Palette.foreground.transparentize(0.45);
                    }

                    // Image preview
                    if Dlc.row-selected && !Dlc.preview-is-audio: Rectangle {
                        height: 190px;
                        border-radius: 4px;
                        background: Palette.background;
                        border-width: 1px;
                        border-color: Palette.border;
                        if Dlc.preview-image-available: Image {
                            source: Dlc.preview-image;
                            image-fit: contain;
                            width: parent.width - 12px;
                            height: parent.height - 12px;
                        }
                        if !Dlc.preview-image-available: Text {
                            text: Dlc.detail-installed ? "No preview image in this pack"
                                                       : "Download to see a preview";
                            color: Palette.foreground.transparentize(0.55);
                            font-size: 11px;
                            wrap: word-wrap;
                            horizontal-alignment: center;
                        }
                    }

                    // Audio preview
                    if Dlc.row-selected && Dlc.preview-is-audio: Rectangle {
                        height: 60px;
                        border-radius: 4px;
                        background: Palette.background;
                        border-width: 1px;
                        border-color: Palette.border;
                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;
                            alignment: center;
                            if Dlc.audio-available && Dlc.detail-installed: Button {
                                text: Dlc.audio-playing ? "Stop" : "Play sample";
                                clicked => {
                                    if (Dlc.audio-playing) {
                                        DlcActions.stop-preview();
                                    } else {
                                        DlcActions.play-preview();
                                    }
                                }
                            }
                            if !Dlc.audio-available || !Dlc.detail-installed: Text {
                                text: !Dlc.audio-available
                                        ? "Audio preview unavailable in this build"
                                        : "Download to hear a sample";
                                vertical-alignment: center;
                                color: Palette.foreground.transparentize(0.55);
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    if Dlc.row-selected && Dlc.detail-description != "": Text {
                        text: Dlc.detail-description;
                        wrap: word-wrap;
                        font-size: 11px;
                        color: Palette.foreground.transparentize(0.2);
                    }

                    if Dlc.row-selected && Dlc.detail-installed: Button {
                        text: "Open pack folder";
                        clicked => { DlcActions.open-folder(); }
                    }
                }
            }
        }

        // ---- Action bar ---------------------------------------------------
        HorizontalBox {
            padding: 0px;
            spacing: 10px;
            vertical-stretch: 0;

            if Dlc.busy: HorizontalBox {
                padding: 0px;
                spacing: 8px;
                horizontal-stretch: 1;
                Text {
                    text: Dlc.busy-label;
                    vertical-alignment: center;
                    color: Palette.foreground.transparentize(0.25);
                    overflow: elide;
                }
                ProgressIndicator {
                    width: 220px;
                    y: (parent.height - self.height) / 2;
                    // A download with no Content-Length, or an extraction,
                    // reports no fraction -- spin rather than lie.
                    indeterminate: Dlc.busy-fraction < 0;
                    progress: Dlc.busy-fraction < 0 ? 0 : Dlc.busy-fraction;
                }
                Button {
                    text: "Cancel";
                    clicked => { DlcActions.cancel(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            if !Dlc.busy: Text {
                text: Dlc.status-message;
                vertical-alignment: center;
                color: Dlc.status-is-error ? #d1495b : Palette.foreground.transparentize(0.35);
                overflow: elide;
                horizontal-stretch: 1;
            }

            Button {
                text: "Remove";
                icon: @image-url("../../assets/icons/x.svg");
                colorize-icon: true;
                enabled: Dlc.row-selected && Dlc.detail-installed && !Dlc.busy;
                clicked => { DlcActions.remove(); }
            }
            Button {
                text: Dlc.detail-status == "Update" ? "Update" : "Download";
                enabled: Dlc.row-selected && !Dlc.busy && !Dlc.offline
                    && Dlc.detail-status != "Installed" && Dlc.detail-status != "Removed";
                clicked => { DlcActions.download(); }
            }
            Button {
                text: !Dlc.mods-mode ? "Use this pack" : Dlc.detail-on ? "Turn off" : "Turn on";
                icon: @image-url("../../assets/icons/player-play.svg");
                colorize-icon: true;
                primary: true;
                enabled: Dlc.row-selected && Dlc.detail-installed && !Dlc.busy;
                clicked => { DlcActions.apply-selection(); }
            }
        }
    }

    if About.open: AboutDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }
}
