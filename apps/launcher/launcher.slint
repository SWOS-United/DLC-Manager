// launcher.slint -- the SWOS United Launcher UI.
//
// Structure follows the Delphi form (miniLauncher_u.dfm): a tabbed settings
// surface over a persistent action bar. Every setting is exposed through the
// `Config` global so C++ can bind it in one place -- see src/main.cpp.
//
// Values are indices, not strings, because that is what gameLauncher.ini and
// the game's command line carry; the *-model properties supply the display
// text for each index.

import {
    Button, CheckBox, ComboBox, GroupBox, HorizontalBox, LineEdit, ScrollView,
    VerticalBox, Palette
} from "std-widgets.slint";

// Every persisted setting, mirroring swos::Settings. C++ pushes the loaded
// values in at startup and reads them back when Run or Exit is pressed.
export global Config {
    // --- Gameplay ---
    in-out property <int> game-style: 0;
    in-out property <int> improved-cpu-tactics: 0;
    in-out property <int> stronger-goalkeeper-ai: 0;
    in-out property <bool> super-power-cpu-mode: false;
    in-out property <string> season-year: "1996";
    in-out property <bool> career-crash-fix: true;
    in-out property <bool> career-fix-0: true;
    in-out property <bool> career-fix-1: true;
    in-out property <bool> career-fix-2: true;
    in-out property <bool> career-fix-3: true;

    // --- Display ---
    in-out property <int> screen-mode: 0;
    in-out property <int> resolution: 0;
    in-out property <bool> full-screen: false;
    in-out property <bool> aspect-ratio: true;
    in-out property <bool> auto-centering: false;
    in-out property <int> screen-enhancement: 0;
    in-out property <int> screen-filter: 0;
    in-out property <int> shader-program: 0;
    in-out property <int> monitor-id: 0;
    in-out property <int> window-scale: 0;
    in-out property <int> colour-palette: 0;

    // --- Presentation ---
    in-out property <int> menu-style: 0;
    in-out property <int> new-scoreboard: 1;
    in-out property <int> menu-bg-image: 0;
    in-out property <bool> alpha-blending-menu: false;
    in-out property <int> alpha-blending-percent: 9;
    in-out property <int> flashing-cursor: 0;
    in-out property <int> mouse-cursor: 0;
    in-out property <bool> new-show-result: false;
    in-out property <bool> remove-darken-banner: false;
    in-out property <bool> show-fps: false;
    in-out property <bool> improved-pitch-palette: true;
    in-out property <bool> ball-trails: false;

    // --- Startup ---
    in-out property <bool> skip-intro: true;
    in-out property <bool> skip-reel: true;
    in-out property <bool> no-load-pause: false;
    in-out property <bool> auto-close-launcher: false;

    // Which tab is showing. Persisted so the launcher reopens where you left
    // it, and settable from C++ for the scripted smoke test.
    in-out property <int> active-tab: 0;

    // --- Option lists (filled from C++) ---
    in property <[string]> game-style-model;
    in property <[string]> cpu-tactics-model;
    in property <[string]> goalkeeper-model;
    in property <[string]> screen-mode-model;
    in property <[string]> resolution-model;
    in property <[string]> enhancement-model;
    in property <[string]> filter-model;
    in property <[string]> shader-model;
    in property <[string]> monitor-model;
    in property <[string]> window-scale-model;
    in property <[string]> palette-model;
    in property <[string]> menu-style-model;
    in property <[string]> scoreboard-model;
    in property <[string]> bg-image-model;
    in property <[string]> alpha-percent-model;
    in property <[string]> flashing-cursor-model;
    in property <[string]> mouse-cursor-model;

    // --- Status ---
    in property <string> launcher-version: "0.1.0";
    in property <string> swos-path: "";
    in property <bool> game-found: false;
    in property <string> status-message: "";
    in property <string> command-preview: "";

    // Changing the screen mode swaps the resolution list, so C++ has to rebuild
    // it rather than the UI picking from a static table.
    callback screen-mode-changed(int);
    callback settings-changed();
}

// Light / dark. Slint's own backends detect the desktop setting, but a custom
// platform gets no such signal, so C++ resolves the preference (see
// src/system_theme.cpp) and calls apply().
export global Theme {
    // 0 = follow the desktop, 1 = light, 2 = dark -- the persisted preference.
    in-out property <int> mode: 0;
    // What the desktop is actually set to, resolved by C++: 1 light, 2 dark.
    // Only consulted when mode is 0.
    in-out property <int> system-scheme: 1;

    out property <bool> is-dark: mode == 2 || (mode == 0 && system-scheme == 2);

    public function apply() {
        Palette.color-scheme = self.is-dark ? ColorScheme.dark : ColorScheme.light;
    }
}

export global Actions {
    callback run-game();
    callback exit-app();
    callback toggle-fullscreen();
    callback browse-swos-dir();
    // Persist the new preference; C++ re-resolves and calls Theme.apply().
    callback theme-changed(int);
}

// Tabler icons are monochrome `currentColor` SVGs, so one file serves both
// themes -- colorize does the rest.
component Icon inherits Image {
    in property <length> size: 18px;
    in property <color> tint: Palette.foreground;
    width: root.size;
    height: root.size;
    colorize: root.tint;
    image-fit: contain;
    accessible-role: none;
}

// A label + control row, so every setting lines up on the same gutter. The
// control column is a fixed width and a spacer eats the rest, otherwise combo
// boxes stretch the full window width and the form reads as a wall of boxes.
component Field inherits HorizontalBox {
    in property <string> label;
    in property <length> label-width: 190px;
    in property <length> control-width: 300px;
    // Settings rows are a fixed height. Beyond looking right, this is what
    // stops a row inside an `if` from absorbing the group box's spare height
    // and growing its control into a tall empty box -- very visible full
    // screen, where there is a lot of spare height to absorb.
    in property <length> row-height: 32px;
    height: root.row-height;
    vertical-stretch: 0;
    padding: 0px;
    spacing: 10px;
    Text {
        text: root.label;
        width: root.label-width;
        vertical-alignment: center;
        horizontal-alignment: right;
        color: Palette.foreground;
        overflow: elide;
    }
    HorizontalLayout {
        width: root.control-width;
        spacing: 8px;
        @children
    }
    Rectangle { horizontal-stretch: 1; }
}

component SectionTitle inherits Text {
    font-size: 13px;
    font-weight: 700;
    color: Palette.accent-background;
}

// std-widgets' TabWidget has no icon support, so the tab strip is built here.
component TabButton inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    callback clicked();

    height: 40px;
    background: root.selected ? Palette.accent-background.transparentize(0.85)
              : touch.has-hover ? Palette.foreground.transparentize(0.94)
              : transparent;
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 16px;
        spacing: 8px;
        alignment: center;
        Icon {
            source: root.icon;
            tint: root.selected ? Palette.accent-background : Palette.foreground;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            vertical-alignment: center;
            font-weight: root.selected ? 700 : 400;
            color: root.selected ? Palette.accent-background : Palette.foreground;
        }
    }

    // The selected tab gets an underline rather than a filled pill, so the
    // strip stays readable in both themes.
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.selected ? Palette.accent-background : transparent;
        border-radius: 1px;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Sun / moon / auto, matching the three ThemePreference values.
component ThemeToggle inherits HorizontalLayout {
    spacing: 2px;

    for entry[index] in [
        { icon: @image-url("../../assets/icons/brightness-auto.svg"), tip: "Follow the system theme" },
        { icon: @image-url("../../assets/icons/sun.svg"), tip: "Light theme" },
        { icon: @image-url("../../assets/icons/moon.svg"), tip: "Dark theme" },
    ] : Rectangle {
        width: 30px;
        height: 26px;
        border-radius: 5px;
        background: Theme.mode == index ? Palette.accent-background.transparentize(0.8)
                  : entry-touch.has-hover ? Palette.foreground.transparentize(0.92)
                  : transparent;

        Icon {
            size: 16px;
            source: entry.icon;
            tint: Theme.mode == index ? Palette.accent-background
                                      : Palette.foreground.transparentize(0.3);
        }

        entry-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                Theme.mode = index;
                Theme.apply();
                Actions.theme-changed(index);
            }
        }
        accessible-role: button;
        accessible-label: entry.tip;
    }
}

export component LauncherWindow inherits Window {
    title: "SWOS United Launcher";
    preferred-width: 940px;
    preferred-height: 760px;
    min-width: 760px;
    min-height: 560px;
    background: Palette.background;

    // A settings form stops being readable past about this width: on an
    // ultrawide or a fullscreen 4K panel the label and its control end up at
    // opposite ends of the screen. Cap it and centre instead.
    //
    // Centring is done with a spacer either side rather than
    // `width: min(root.width, ...)`, which reads the window width from inside
    // the layout that determines it and so forms a binding loop. The content
    // outweighs the spacers heavily, so it absorbs the spare width until
    // max-width clamps it and only then do the spacers grow.
    property <length> content-width: 1100px;

    HorizontalLayout {
        Rectangle { horizontal-stretch: 1; }
        VerticalBox {
        horizontal-stretch: 200;
        max-width: root.content-width + 28px;
        padding: 14px;
        spacing: 10px;

        // ---- Header ----------------------------------------------------
        HorizontalBox {
            padding: 0px;
            spacing: 12px;
            vertical-stretch: 0;

            VerticalLayout {
                alignment: center;
                Text {
                    text: "SWOS United Launcher";
                    font-size: 22px;
                    font-weight: 800;
                    color: Palette.foreground;
                }
                Text {
                    text: "Sensible World of Soccer \{Config.launcher-version}";
                    font-size: 11px;
                    color: Palette.foreground.transparentize(0.4);
                }
            }

            Rectangle { horizontal-stretch: 1; }

            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: Config.game-found ? "Game found" : "Game not found";
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: right;
                    color: Config.game-found ? #3fa34d : #d1495b;
                }
                Text {
                    text: Config.swos-path;
                    font-size: 10px;
                    horizontal-alignment: right;
                    color: Palette.foreground.transparentize(0.45);
                    overflow: elide;
                    max-width: 420px;
                }
            }

            VerticalLayout {
                alignment: center;
                ThemeToggle { }
            }
        }

        // ---- Tab strip --------------------------------------------------
        Rectangle {
            vertical-stretch: 0;
            height: 40px;
            HorizontalLayout {
                alignment: start;
                spacing: 2px;
                for tab[index] in [
                    { label: "General",  icon: @image-url("../../assets/icons/device-gamepad-2.svg") },
                    { label: "Display",  icon: @image-url("../../assets/icons/device-desktop.svg") },
                    { label: "Advanced", icon: @image-url("../../assets/icons/adjustments.svg") },
                    { label: "About",    icon: @image-url("../../assets/icons/info-circle.svg") },
                ] : TabButton {
                    label: tab.label;
                    icon: tab.icon;
                    selected: Config.active-tab == index;
                    clicked => { Config.active-tab = index; }
                }
            }
            // Baseline the selected tab's underline sits on.
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Palette.border;
            }
        }

        // ---- Pages -------------------------------------------------------
        Rectangle {
            vertical-stretch: 1;

            // General ------------------------------------------------------
            if Config.active-tab == 0: ScrollView {
                VerticalBox {
                    padding: 10px;
                    spacing: 14px;
                    alignment: start;
                    max-width: root.content-width;

                    GroupBox {
                        title: "Game";
                        VerticalBox {
                            spacing: 8px;
                            alignment: start;
                            Field {
                                label: "Game style";
                                ComboBox {
                                    model: Config.game-style-model;
                                    current-index <=> Config.game-style;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "CPU tactics";
                                ComboBox {
                                    model: Config.cpu-tactics-model;
                                    current-index <=> Config.improved-cpu-tactics;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "Goalkeeper AI";
                                ComboBox {
                                    model: Config.goalkeeper-model;
                                    current-index <=> Config.stronger-goalkeeper-ai;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "Colour palette";
                                ComboBox {
                                    model: Config.palette-model;
                                    current-index <=> Config.colour-palette;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "Season year";
                                control-width: 120px;
                                LineEdit {
                                    text <=> Config.season-year;
                                    input-type: number;
                                    edited => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "";
                                CheckBox {
                                    text: "Super power CPU mode";
                                    // The Delphi SetUI enabled this only for
                                    // non-DOS game styles.
                                    enabled: Config.game-style >= 1;
                                    checked <=> Config.super-power-cpu-mode;
                                    toggled => { Config.settings-changed(); }
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Career";
                        VerticalBox {
                            spacing: 8px;
                            alignment: start;
                            CheckBox {
                                text: "Apply career crash fixes";
                                checked <=> Config.career-crash-fix;
                                toggled => { Config.settings-changed(); }
                            }
                            HorizontalBox {
                                padding-left: 20px;
                                spacing: 18px;
                                CheckBox {
                                    text: "Fix 1";
                                    enabled: Config.career-crash-fix;
                                    checked <=> Config.career-fix-0;
                                    toggled => { Config.settings-changed(); }
                                }
                                CheckBox {
                                    text: "Fix 2";
                                    enabled: Config.career-crash-fix;
                                    checked <=> Config.career-fix-1;
                                    toggled => { Config.settings-changed(); }
                                }
                                CheckBox {
                                    text: "Fix 3";
                                    enabled: Config.career-crash-fix;
                                    checked <=> Config.career-fix-2;
                                    toggled => { Config.settings-changed(); }
                                }
                                CheckBox {
                                    text: "Fix 4";
                                    enabled: Config.career-crash-fix;
                                    checked <=> Config.career-fix-3;
                                    toggled => { Config.settings-changed(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }

                    GroupBox {
                        title: "Startup";
                        VerticalBox {
                            spacing: 6px;
                            alignment: start;
                            CheckBox {
                                text: "Skip intro";
                                checked <=> Config.skip-intro;
                                toggled => { Config.settings-changed(); }
                            }
                            CheckBox {
                                text: "Skip image reels";
                                checked <=> Config.skip-reel;
                                toggled => { Config.settings-changed(); }
                            }
                            CheckBox {
                                text: "No pause while loading";
                                checked <=> Config.no-load-pause;
                                toggled => { Config.settings-changed(); }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // Display ------------------------------------------------------
            if Config.active-tab == 1: ScrollView {
                VerticalBox {
                    padding: 10px;
                    spacing: 14px;
                    alignment: start;
                    max-width: root.content-width;

                    GroupBox {
                        title: "Screen";
                        VerticalBox {
                            spacing: 8px;
                            alignment: start;
                            Field {
                                label: "Screen mode";
                                ComboBox {
                                    model: Config.screen-mode-model;
                                    current-index <=> Config.screen-mode;
                                    // Swapping the mode swaps the resolution
                                    // list, which only C++ can rebuild.
                                    selected => {
                                        Config.screen-mode-changed(self.current-index);
                                    }
                                }
                            }
                            Field {
                                label: "Resolution";
                                ComboBox {
                                    model: Config.resolution-model;
                                    current-index <=> Config.resolution;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "Monitor";
                                control-width: 420px;
                                ComboBox {
                                    model: Config.monitor-model;
                                    current-index <=> Config.monitor-id;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "";
                                row-height: 86px;
                                VerticalBox {
                                    padding: 0px;
                                    spacing: 6px;
                                    CheckBox {
                                        text: "Full screen";
                                        checked <=> Config.full-screen;
                                        toggled => { Config.settings-changed(); }
                                    }
                                    CheckBox {
                                        text: "Keep aspect ratio";
                                        checked <=> Config.aspect-ratio;
                                        toggled => { Config.settings-changed(); }
                                    }
                                    CheckBox {
                                        text: "Auto centering";
                                        checked <=> Config.auto-centering;
                                        toggled => { Config.settings-changed(); }
                                    }
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Image quality";
                        VerticalBox {
                            spacing: 8px;
                            alignment: start;
                            Field {
                                label: "Enhancement";
                                ComboBox {
                                    model: Config.enhancement-model;
                                    current-index <=> Config.screen-enhancement;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            // SetUI showed exactly one of these two, chosen by
                            // the enhancement mode. The wrapper matters: a bare
                            // `if` row is treated as a stretching layout child
                            // and grows the control into a tall empty box when
                            // there is spare height (very visible full screen).
                            VerticalLayout {
                                alignment: start;
                                vertical-stretch: 0;
                                if Config.screen-enhancement == 0: Field {
                                    label: "Pixel scaler";
                                    ComboBox {
                                        model: Config.filter-model;
                                        current-index <=> Config.screen-filter;
                                        selected => { Config.settings-changed(); }
                                    }
                                }
                                if Config.screen-enhancement != 0: Field {
                                    label: "Shader program";
                                    ComboBox {
                                        model: Config.shader-model;
                                        current-index <=> Config.shader-program;
                                        selected => { Config.settings-changed(); }
                                    }
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "Launcher window";
                        VerticalBox {
                            spacing: 8px;
                            alignment: start;
                            Field {
                                label: "Interface scale";
                                ComboBox {
                                    model: Config.window-scale-model;
                                    current-index <=> Config.window-scale;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "";
                                Button {
                                    text: "Toggle full screen (Alt+Enter)";
                                    clicked => { Actions.toggle-fullscreen(); }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // Advanced -----------------------------------------------------
            if Config.active-tab == 2: ScrollView {
                VerticalBox {
                    padding: 10px;
                    spacing: 14px;
                    alignment: start;
                    max-width: root.content-width;

                    GroupBox {
                        title: "Menus";
                        VerticalBox {
                            spacing: 8px;
                            alignment: start;
                            Field {
                                label: "Menu style";
                                ComboBox {
                                    model: Config.menu-style-model;
                                    current-index <=> Config.menu-style;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "Scoreboard";
                                ComboBox {
                                    model: Config.scoreboard-model;
                                    current-index <=> Config.new-scoreboard;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "Background image";
                                ComboBox {
                                    model: Config.bg-image-model;
                                    current-index <=> Config.menu-bg-image;
                                    // Only widescreen mode drives the
                                    // background image, per SetUI.
                                    enabled: Config.screen-mode == 2;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "Menu transparency";
                                CheckBox {
                                    text: "";
                                    enabled: Config.screen-mode == 2;
                                    checked <=> Config.alpha-blending-menu;
                                    toggled => { Config.settings-changed(); }
                                }
                                ComboBox {
                                    model: Config.alpha-percent-model;
                                    current-index <=> Config.alpha-blending-percent;
                                    enabled: Config.alpha-blending-menu
                                        && Config.screen-mode == 2;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "Menu cursor";
                                ComboBox {
                                    model: Config.flashing-cursor-model;
                                    current-index <=> Config.flashing-cursor;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                            Field {
                                label: "Mouse cursor";
                                ComboBox {
                                    model: Config.mouse-cursor-model;
                                    current-index <=> Config.mouse-cursor;
                                    selected => { Config.settings-changed(); }
                                }
                            }
                        }
                    }

                    GroupBox {
                        title: "In game";
                        VerticalBox {
                            spacing: 6px;
                            alignment: start;
                            CheckBox {
                                text: "New show-result screen";
                                checked <=> Config.new-show-result;
                                toggled => { Config.settings-changed(); }
                            }
                            CheckBox {
                                text: "Remove darkened banner";
                                checked <=> Config.remove-darken-banner;
                                toggled => { Config.settings-changed(); }
                            }
                            CheckBox {
                                text: "Improved pitch palette";
                                checked <=> Config.improved-pitch-palette;
                                toggled => { Config.settings-changed(); }
                            }
                            CheckBox {
                                text: "Ball trails";
                                checked <=> Config.ball-trails;
                                toggled => { Config.settings-changed(); }
                            }
                            CheckBox {
                                text: "Show FPS";
                                checked <=> Config.show-fps;
                                toggled => { Config.settings-changed(); }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            // About --------------------------------------------------------
            if Config.active-tab == 3: ScrollView {
                VerticalBox {
                    padding: 10px;
                    spacing: 12px;
                    alignment: start;
                    max-width: root.content-width;

                    SectionTitle { text: "SWOS United Launcher \{Config.launcher-version}"; }
                    Text {
                        text: "Cross-platform C++ port of the SWOS 2020 Game Launcher, "
                            + "built on SDL2, OpenGL 3.3 core and Slint.";
                        wrap: word-wrap;
                        color: Palette.foreground;
                    }

                    // The credits: a box of its own that scrolls, so the list can grow
                    // without pushing the rest of the page down.
                    SectionTitle { text: "SWOS United"; }
                    Rectangle {
                        height: 232px;
                        background: Palette.alternate-background;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Palette.border;
                        ScrollView {
                            VerticalLayout {
                                padding: 10px;
                                alignment: start;      /* rows at the top, not spread over the box */
                                GridLayout {
                                    spacing-horizontal: 16px;
                                    spacing-vertical: 6px;
                                Row {
                                    Text { text: "Project Management"; color: Palette.foreground.transparentize(0.25); }
                                    Text { text: "Playaveli"; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                }
                                Row {
                                    Text { text: "Engineering Lead"; color: Palette.foreground.transparentize(0.25); }
                                    Text { text: "benbaker76"; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                }
                                Row {
                                    Text { text: "SWOS 2020 Feature Engineering"; color: Palette.foreground.transparentize(0.25); }
                                    Text { text: "starwindz"; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                }
                                Row {
                                    Text { text: "SWOS Reverse Engineering"; color: Palette.foreground.transparentize(0.25); }
                                    Text { text: "benbaker76 (Amiga) / zkz (DOS)"; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                }
                                Row {
                                    Text { text: "SWOS Live (swos.eu)"; color: Palette.foreground.transparentize(0.25); }
                                    Text { text: "Redhair"; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                }
                                Row {
                                    Text { text: "SWOS Multiplayer (GGPO-X)"; color: Palette.foreground.transparentize(0.25); }
                                    Text { text: "thd79"; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                }
                                Row {
                                    Text { text: "SWOS Web Online Rankings"; color: Palette.foreground.transparentize(0.25); }
                                    Text { text: "ElMichaJ"; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                }
                                Row {
                                    Text { text: "Custom Graphics"; color: Palette.foreground.transparentize(0.25); }
                                    Text { text: "Francescomanetti82"; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                }
                                Row {
                                    Text { text: "Beta Testers"; color: Palette.foreground.transparentize(0.25); }
                                    Text { text: "crom1, ElMichaJ, EMPI, gatifun, petarku, Playaveli, Predicador, Redhair, segra, starwindz, thd79"; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                }
                                Row {
                                    Text { text: "Donators"; color: Palette.foreground.transparentize(0.25); }
                                    Text { text: "benbaker76, Playaveli, starwindz, Petarku, gatifun, burellapaolo, az0man0, Cartoplotus68, JoSon, aliko"; wrap: word-wrap; color: Palette.foreground; horizontal-stretch: 1; }
                                }
                                }
                            }
                        }
                    }

                    SectionTitle { text: "Game directory"; }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 8px;
                        Text {
                            text: Config.swos-path;
                            vertical-alignment: center;
                            color: Palette.foreground.transparentize(0.25);
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        Button {
                            text: "Reveal";
                            icon: @image-url("../../assets/icons/folder-open.svg");
                            colorize-icon: true;
                            clicked => { Actions.browse-swos-dir(); }
                        }
                    }

                    SectionTitle { text: "Launch command"; }
                    Rectangle {
                        background: Palette.alternate-background;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Palette.border;
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: Config.command-preview;
                                wrap: word-wrap;
                                font-family: "monospace";
                                font-size: 11px;
                                color: Palette.foreground;
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }
        }

        // ---- Action bar -------------------------------------------------
        HorizontalBox {
            padding: 0px;
            spacing: 10px;
            vertical-stretch: 0;

            CheckBox {
                text: "Close launcher after starting the game";
                checked <=> Config.auto-close-launcher;
                toggled => { Config.settings-changed(); }
            }

            Text {
                text: Config.status-message;
                vertical-alignment: center;
                color: Palette.foreground.transparentize(0.35);
                overflow: elide;
                horizontal-stretch: 1;
            }

            Button {
                text: "Exit";
                icon: @image-url("../../assets/icons/x.svg");
                colorize-icon: true;
                clicked => { Actions.exit-app(); }
            }
            Button {
                text: "Run SWOS";
                icon: @image-url("../../assets/icons/player-play.svg");
                colorize-icon: true;
                primary: true;
                enabled: Config.game-found;
                clicked => { Actions.run-game(); }
            }
        }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}
